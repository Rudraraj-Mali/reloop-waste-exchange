# Cloudflare D1 SQL Database Configuration
CLOUDFLARE_API_KEY=your_cloudflare_api_key_or_token
CLOUDFLARE_EMAIL=your_cloudflare_account_email@example.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_cloudflare_d1_database_uuid

# Application Server Port
PORT=3000

# Azure SQL (Optional Legacy Fallback)
DB_SERVER=your-azure-sql-server.database.windows.net
DB_DATABASE=reloop_db
DB_USER=azure_admin
DB_PASSWORD=YourStrongPassword123!
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
